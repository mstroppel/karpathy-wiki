{
  "update": "disable",
  "share": "disabled",
  "snapshots": false,
  "instructions": ["/etc/opencode/routing.md"],
  "skills": ["/etc/opencode/skills"],
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 16384
  },
  "agents": {
    "wiki-ingest": {
      "description": "Liest ausdrücklich angeforderte Quellen in das Wiki ein.",
      "mode": "subagent",
      "system": "Bearbeite ausschließlich Einleseaufträge für das Wiki. Delegiere nicht erneut. Lade einmal den Skill wiki-ingest, befolge ihn vollständig und führe den Auftrag selbst aus.",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "wiki-lint": {
      "description": "Prüft und wartet das Wiki.",
      "mode": "subagent",
      "system": "Bearbeite ausschließlich Prüf- und Wartungsaufträge für das Wiki. Delegiere nicht erneut. Lade einmal den Skill wiki-lint, befolge ihn vollständig und führe den Auftrag selbst aus.",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "wiki-analysis": {
      "description": "Analysiert Fragen anhand des Wikis und aktueller wissenschaftlicher Internetquellen.",
      "mode": "subagent",
      "steps": 10,
      "system": "Bearbeite ausschließlich ausdrücklich angeforderte wissenschaftliche Analysen. Delegiere nicht erneut. Lade einmal den Skill wiki-analysis, befolge ihn vollständig und führe den Auftrag selbst aus.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "wiki-analysis-save": {
      "description": "Speichert eine fertige Analyse als Wiki-Seite mit verlinkbarer Druckansicht.",
      "mode": "subagent",
      "system": "Bearbeite ausschließlich Aufträge, eine fertige Analyse als Wiki-Seite zu speichern. Delegiere nicht erneut. Lade einmal den Skill wiki-analysis-save, befolge ihn vollständig und führe den Auftrag selbst aus.",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "commands": {
    "ingest": {
      "description": "Quelle einlesen",
      "agent": "wiki-ingest",
      "subagent": true,
      "template": "Führe diesen Einleseauftrag vollständig aus: $ARGUMENTS"
    },
    "ingest-new": {
      "description": "Alle neuen und geänderten Quellen einlesen",
      "agent": "wiki-ingest",
      "subagent": true,
      "template": "Lies alle neuen und geänderten Quellen unter /knowledge/sources strikt nacheinander ein. Arbeite alle Adapter und Einträge der Statusliste ab; beende den Auftrag erst nach einer abschließenden Statusprüfung mit new=0 und outdated=0 oder benenne einen konkreten Blocker und die offenen Quellen."
    },
    "lint": {
      "description": "Wiki prüfen",
      "agent": "wiki-lint",
      "subagent": true,
      "template": "Führe diesen Prüfauftrag vollständig aus: $ARGUMENTS"
    },
    "analyse": {
      "description": "Wissenschaftliche Analyse mit Internetquellen",
      "agent": "wiki-analysis",
      "subagent": false,
      "template": "$ARGUMENTS"
    },
    "analyse-save": {
      "description": "Analyse im Wiki speichern (Seite und Druckansicht)",
      "agent": "wiki-analysis-save",
      "subagent": true,
      "template": "Führe diesen Speicherauftrag vollständig aus, inklusive der vollständigen zu speichernden Analyse: $ARGUMENTS"
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": ".git/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/knowledge/wiki/.git/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/knowledge/sources/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/knowledge/raw/**",
      "effect": "deny"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "wiki-analysis",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "wiki-analysis-save",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "wiki-ingest",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "wiki-lint",
      "effect": "allow"
    },
    {
      "action": "wiki_ingest_status",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/knowledge/sources/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/knowledge/raw/**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "stat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git add *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git mv *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rm *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git -C /knowledge/wiki status*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git -C /knowledge/wiki diff*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git -C /knowledge/wiki log*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git -C /knowledge/wiki show*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git -C /knowledge/wiki rev-parse*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git -C /knowledge/wiki add *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git -C /knowledge/wiki mv *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git -C /knowledge/wiki rm *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git -C /knowledge/wiki commit *",
      "effect": "allow"
    }
  ]
}
