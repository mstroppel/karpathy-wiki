{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "snapshots": false,
  "skills": ["/etc/opencode/skills"],
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 16384
  },
  "agents": {
    "wiki-ingest": {
      "description": "Bearbeitet einen vom Batch-Tool exklusiv gesperrten Einlesebatch direkt im Wiki.",
      "mode": "subagent",
      "system": "Bearbeite ausschließlich vom wiki_ingest_batch-Tool übergebene Batches. Ohne batch_id nichts ändern; an wiki-ingest-orchestrator verweisen. Lade wiki-ingest einmal. Nutze normale Lese- und Editierwerkzeuge, keine Shell, kein Git und keine Delegation.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "/knowledge/wiki/**",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "sources/*.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "entities/*.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "concepts/*.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "analyses/*.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "overview.md",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": ".git/*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "AGENTS.md",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*/AGENTS.md",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": ".opencode/*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "/knowledge/sources/**",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "/knowledge/wiki/**",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "/knowledge/wiki/AGENTS.md",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "/etc/opencode/skills/wiki-ingest/*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "/knowledge/wiki/.git/**",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "/knowledge/wiki/AGENTS.md",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "wiki-ingest",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "/knowledge/sources/**",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "/etc/opencode/skills/wiki-ingest/**",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "/knowledge/wiki/.git/**",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": ".git/*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "/knowledge/wiki/**/AGENTS.md",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "/knowledge/wiki/.opencode/**",
          "effect": "deny"
        }
      ]
    },
    "wiki-ingest-orchestrator": {
      "description": "Startet kleine, exklusive Einlesebatches und verlinkt ihre Berichte.",
      "mode": "all",
      "system": "Lade wiki-ingest-orchestrator. Starte wiki_ingest_batch stets sequenziell. Das Tool hält den Lock über Worker und Commit. Keine eigenen Änderungen oder manuelle Worker-Delegation. Bei Blockern stoppen und private Berichte verlinken.",
      "permissions": [
        {
          "action": "read",
          "resource": "/knowledge/incoming/ingest-journal/**",
          "effect": "deny"
        },
        {
          "action": "wiki_ingest_transaction",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "wiki_ingest_batch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "wiki_ingest_journal",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "wiki-lint": {
      "description": "Prüft und wartet das Wiki.",
      "mode": "subagent",
      "system": "Bearbeite ausschließlich Prüf- und Wartungsaufträge für das Wiki. Delegiere nicht erneut. Lade einmal den Skill wiki-lint, befolge ihn vollständig und führe den Auftrag selbst aus.",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "wiki-analysis": {
      "description": "Analysiert Fragen anhand des Wikis und aktueller wissenschaftlicher Internetquellen.",
      "mode": "subagent",
      "system": "Bearbeite ausschließlich ausdrücklich angeforderte wissenschaftliche Analysen. Delegiere nicht erneut. Lade einmal den Skill wiki-analysis, befolge ihn vollständig und führe den Auftrag selbst aus.",
      "permissions": [
        {
          "action": "wiki_ingest_transaction",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "wiki_ingest_journal",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "wiki-analysis-save": {
      "description": "Speichert eine fertige Analyse als Wiki-Seite mit verlinkbarer Druckansicht.",
      "mode": "subagent",
      "system": "Bearbeite ausschließlich Aufträge, eine fertige Analyse als Wiki-Seite zu speichern. Delegiere nicht erneut. Lade einmal den Skill wiki-analysis-save, befolge ihn vollständig und führe den Auftrag selbst aus.",
      "permissions": [
        {
          "action": "wiki_ingest_transaction",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "wiki_ingest_journal",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "commands": {
    "ingest": {
      "description": "Quelle einlesen",
      "agent": "wiki-ingest-orchestrator",
      "subagent": false,
      "template": "Lade wiki-ingest-orchestrator. Verarbeite nur die ausdrücklich angeforderte neue/geänderte Quelle über wiki_ingest_batch mit source_path aus wiki_ingest_status. Auftrag: $ARGUMENTS"
    },
    "ingest-new": {
      "description": "Alle neuen und geänderten Quellen einlesen",
      "agent": "wiki-ingest-orchestrator",
      "subagent": false,
      "template": "Lade wiki-ingest-orchestrator. Verarbeite alle neuen und geänderten Quellen unter /knowledge/sources über wiki_ingest_batch in sequenziellen kleinen Batches, ein Commit pro Batch. Bei Blockern stoppen, nichts zurücksetzen. Verlinke jeden privaten Bericht mit dem dauerhaften Berichtspfad und schließe mit einer kurzen Zusammenfassung und frischer Statusprüfung ab."
    },
    "lint": {
      "description": "Wiki prüfen",
      "agent": "wiki-lint",
      "subagent": true,
      "template": "Führe diesen Prüfauftrag vollständig aus: $ARGUMENTS"
    },
    "analysis": {
      "description": "Wissenschaftliche Analyse mit Internetquellen",
      "agent": "wiki-analysis",
      "subagent": false,
      "template": "$ARGUMENTS"
    },
    "analysis-save": {
      "description": "Analyse ins Wiki aufnehmen (Seite, Index, Log und Druckansicht)",
      "agent": "build",
      "subagent": false,
      "template": "Nimm die fertige Analyse ins Wiki auf (Seite, Index, Log und Druckansicht): Finde im bisherigen Gespräch die letzte vollständige Analyse einschließlich späterer Korrekturen. Falls der folgende Auftrag selbst einen vollständigen Analysetext enthält, verwende stattdessen diesen. Prüfe bei einer Analyse aus einem Subagenten-Ergebnis auf Kürzungsmarker ([showing ...; full output saved to ...]). Lies in diesem Fall die vollständige gespeicherte Tool-Ausgabe stückweise über den read-Befehl; wenn sie nicht vollständig wiederherstellbar ist, speichere nichts und melde den Grund. Übergib nur den vollständigen zu speichernden Text an den Subagenten wiki-analysis-save, nicht nur einen Verweis auf das Gespräch. Ist keine fertige Analyse vorhanden, speichere nichts und melde das. Auftrag: $ARGUMENTS"
    },
    "answer-save": {
      "description": "Bestätigte Antworten in den lokalen Eingang speichern",
      "agent": "build",
      "subagent": false,
      "template": "Speichere die in diesem Gespräch zuletzt ausdrücklich bestätigten Antworten als neue Eingangsdatei unter /knowledge/incoming/answers. Lade den Skill wiki-gap-review und führe ausschließlich dessen Schritt 1 (Lokal speichern) für diese Antworten aus. Ohne ausdrücklich bestätigte, tatsächlich beantwortete Frage speichere nichts und melde das. Vorhandene Entwürfe weder lesen noch ändern; niemals unter /knowledge/sources schreiben. Auftrag: $ARGUMENTS"
    },
    "gap-review": {
      "description": "Wiki-Lücken prüfen, Fragen beantworten und bestätigte Antworten einreichen",
      "agent": "build",
      "subagent": false,
      "template": "Lade den Skill wiki-gap-review und führe eine interaktive Lückenprüfung durch. Prüfe zunächst ausschließlich lesend; halte nummerierte Fragen und Antworten über die weiteren Gesprächsrunden fest. Reiche erst nach ausdrücklicher Bestätigung bestätigte Antworten über den lokalen Eingang und den Anbieter ein. Auftrag: $ARGUMENTS"
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": ".git/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/knowledge/wiki/.git/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/knowledge/sources/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/home/opencode/.local/share/opencode/tool-output/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/etc/opencode/skills/**",
      "effect": "deny"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "wiki-analysis",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "wiki-analysis-save",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "wiki-gap-review",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "wiki-ingest",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "wiki-ingest-orchestrator",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "wiki-lint",
