# Identity and host integration
COMPOSE_PROJECT_NAME=karpathy-wiki
STACK_ID=karpathy-wiki
WIKI_NAME=Karpathy Wiki
WIKI_PUBLIC_URL=https://wiki.example.com
OPENCHAMBER_PUBLIC_URL=https://chat.example.com
OPENCHAMBER_UI_PASSWORD=replace-with-separate-random-secret
OPENCODE_PASSWORD=replace-with-random-secret
DATA_ROOT=./data
# Safe launcher updates require private local storage outside DATA_ROOT.
KARPATHY_WIKI_BACKUP_DIR=./backups
# Include required external reverse-proxy configuration (JSON array of paths).
KARPATHY_WIKI_BACKUP_EXTRA_PATHS=[]
PUID=1000
PGID=1000
TZ=Europe/Berlin
WEBPROXY_NETWORK=webproxy

# Enable source and export adapters as needed.
# Available profiles: webdav, audio, answers, email, paperless, raw-files
# List profiles comma-separated without spaces, for example:
#   COMPOSE_PROFILES=webdav,paperless,raw-files
COMPOSE_PROFILES=

# Chat/backend images and configuration
# KARPATHY_WIKI_CHANNEL: stable (follow releases) or pre (follow pre-releases)
KARPATHY_WIKI_CHANNEL=stable
KARPATHY_WIKI_VERSION=latest
GIT_AUTHOR_NAME=Karpathy Wiki Agent
GIT_AUTHOR_EMAIL=karpathy-wiki@localhost

# Opt-in kernel-enforced reader topology. Disables ALL wiki/journal/answer writes
# by the model runtime, including /ingest-new, /analysis-save and confirmed
# /gap-review saves. See docs/runtime-write-isolation.md.
WIKI_RUNTIME_READ_ONLY=false

# WebDAV source ingestion (WEBDAV_VENDOR examples: nextcloud, owncloud, sharepoint)
WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/username/
WEBDAV_VENDOR=nextcloud
WEBDAV_USERNAME=username
# Generate the obscured value with any rclone release; the obscured format is
# stable across rclone versions:
#   docker run --rm rclone/rclone:latest obscure 'your-password'
WEBDAV_PASSWORD_OBSCURED=
WEBDAV_PATH=Wiki Sources
WEBDAV_SYNC_INTERVAL=15m

# Optional destructive IMAP email reception (docs/email.md). Original .eml files
# including attachments remain private, unredacted and retained indefinitely.
# Enabling the email profile trusts the entire configured account/folder: ALL
# eligible existing and new mail can be archived and deleted. Use a dedicated
# mailbox or reliably isolated folder; the allowlists below are routing filters,
# not sender or recipient verification.
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
# Optional exact From mailboxes, comma-separated. Not authentication by itself.
EMAIL_FROM_ALLOWLIST=
# Optional exact To/Cc/Bcc mailboxes, comma-separated. Bcc-only deliveries
# arrive without recipient headers and cannot match.
EMAIL_RECIPIENT_ALLOWLIST=
EMAIL_POLL_INTERVAL=60s
EMAIL_BATCH_SIZE=25
EMAIL_MAX_BYTES=26214400
EMAIL_TIMEOUT_SECONDS=30

# Optional audio source ingestion (WebDAV recordings, transcribed on this host).
# The audio connector reuses the WebDAV credentials above and transcribes
# through the speech worker. The default backend (faster-whisper) keeps every
# recording on this host; the opt-in hosted backend below sends raw audio to
# Mistral before redaction.
AUDIO_WEBDAV_PATH=Recordings
# Pause after each cycle finishes; 1m does not schedule overlapping cycles.
AUDIO_SYNC_INTERVAL=1h
# Health bounds per phase, not a deadline for the whole backlog (docs/audio.md).
AUDIO_SYNC_TIMEOUT_SEC=3600
AUDIO_PHASE_TIMEOUT_SEC=600
# Maximum wait/processing time for ONE recording, shared with the speech worker.
SPEECH_TIMEOUT_SEC=43200
AUDIO_DIARIZE=0
# faster-whisper model preset; the hosted backend uses SPEECH_MISTRAL_MODEL.
SPEECH_MODEL=small
# The shipped speech image currently supports CPU only.
SPEECH_DEVICE=cpu
SPEECH_COMPUTE_TYPE=int8
HUGGINGFACE_TOKEN=

# Opt-in hosted transcription with the Mistral speech-to-text service
# (docs/audio.md): raw audio leaves this host and reaches Mistral before any
# transcript redaction. Costs are billed per audio minute and Mistral's
# data-handling terms apply. The API key is a worker-only secret: only the
# speech worker container ever sees it.
# SPEECH_BACKEND=mistral
# SPEECH_MISTRAL_MODEL=voxtral-mini-latest
# MISTRAL_API_KEY_FILE=./secrets/mistral-api-key

# Shared ingestion configuration
REDACTIONS_FILE=./secrets/redactions.json

# Optional Paperless source ingestion
PAPERLESS_PUBLIC_URL=https://paperless.example.com
PAPERLESS_SOURCE_TAG_ID=0
PAPERLESS_SYNC_INTERVAL_SECONDS=900
PAPERLESS_TOKEN_FILE=./secrets/paperless-token
PAPERLESS_BLOCKED_HOSTNAME=paperless.example.com
