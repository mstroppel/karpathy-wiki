# Identity and host integration
COMPOSE_PROJECT_NAME=karpathy-wiki
STACK_ID=karpathy-wiki
WIKI_NAME=Karpathy Wiki
WIKI_PUBLIC_URL=https://wiki.example.com
OPENCODE_PUBLIC_URL=https://chat.example.com
DATA_ROOT=./data
PUID=1000
PGID=1000
TZ=Europe/Berlin
WEBPROXY_NETWORK=webproxy

# Enable source and export adapters as needed.
# Available profiles: webdav, paperless, session-export, raw-files
COMPOSE_PROFILES=

# OpenCode image/configuration
# KARPATHY_WIKI_CHANNEL: stable (follow releases) or pre (follow pre-releases)
KARPATHY_WIKI_CHANNEL=stable
KARPATHY_WIKI_VERSION=latest
GIT_AUTHOR_NAME=Karpathy Wiki Agent
GIT_AUTHOR_EMAIL=karpathy-wiki@localhost

# WebDAV source ingestion (WEBDAV_VENDOR examples: nextcloud, owncloud, sharepoint)
WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/username/
WEBDAV_VENDOR=nextcloud
WEBDAV_USERNAME=username
# Generate the obscured value with: docker run --rm rclone/rclone:1.75.1 obscure 'your-password'
WEBDAV_PASSWORD_OBSCURED=
WEBDAV_PATH=Wiki Sources
WEBDAV_SYNC_INTERVAL=15m

# Shared ingestion configuration
REDACTIONS_FILE=./secrets/redactions.json

# Optional Paperless source ingestion
PAPERLESS_PUBLIC_URL=https://paperless.example.com
PAPERLESS_SOURCE_TAG_ID=0
PAPERLESS_SYNC_INTERVAL_SECONDS=900
PAPERLESS_TOKEN_FILE=./secrets/paperless-token
PAPERLESS_BLOCKED_HOSTNAME=paperless.example.com

# Optional OpenCode session export
WEBDAV_SESSION_PATH=OpenCode Sessions
SESSION_EXPORT_INTERVAL=15m
