{
  "version": 1,
  "topic": "provider-manifests",
  "description": "Conformance cases for provider manifest validation, executed by the Python core (ingest/tests/test_manifest.py) and the JavaScript scanner tests (tests/test_contract_fixtures.mjs).",
  "cases": [
    {
      "name": "minimal valid manifest",
      "valid": true,
      "manifest": {
        "contract": "karpathy-wiki-provider-manifest",
        "version": 1,
        "source": "notes",
        "generated_at": 1760000000,
        "items": [
          {
            "source_key": "meeting.md",
            "source_path": "meeting.md",
            "wiki_path": "notes/meeting/index.md",
            "source_revision": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "frontmatter": {
              "source_revision": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
            },
            "claim": { "source_path": "meeting.md" }
          }
        ],
        "revoked": [],
        "errors": []
      }
    },
    {
      "name": "valid manifest with revocations and errors",
      "valid": true,
      "manifest": {
        "contract": "karpathy-wiki-provider-manifest",
        "version": 1,
        "source": "paperless",
        "generated_at": 1760000000,
        "items": [
          {
            "source_key": "42",
            "source_path": "0000-0999/document-42.md",
            "wiki_path": "0000-0999/paperless-42.md",
            "source_revision": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "frontmatter": {
              "paperless_id": 42,
              "source_revision": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
            },
            "claim": { "paperless_id": "42" }
          }
        ],
        "revoked": [{ "source_key": "7", "claim": { "paperless_id": "7" } }],
        "errors": [
          {
            "source_key": "9",
            "path": "0000-0999/document-9.md",
            "error": "privacy-validation:PrivacyValidationError"
          }
        ]
      }
    },
